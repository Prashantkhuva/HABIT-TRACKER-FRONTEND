{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gsc": {
      "type": "local",
      "command": ["npx", "-y", "suganthan-gsc-mcp"],
      "enabled": true,
      "environment": {
        "GSC_AUTH_MODE": "oauth",
        "GSC_OAUTH_SECRETS_FILE": "{env:GSC_OAUTH_SECRETS_FILE}",
        "GSC_SITE_URL": "sc-domain:habitflow.indevs.in/"
      }
    }
  }
}